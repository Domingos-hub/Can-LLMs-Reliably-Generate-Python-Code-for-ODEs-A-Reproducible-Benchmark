    "import os, re, subprocess, sys, tempfile\n",
    "import pandas as pd\n",
    "from tqdm import tqdm\n",
    "\n",
    "INPUT_FILE = \"ODE_math_benchmark_2026.csv_models\"\n",
    "OUTPUT_FILE = \"ODE_math_benchmark_2026.csv_models_final_results.csv\"\n",
    "SUMMARY_FILE = \"ODE_math_benchmark_2026.csv_models_models_statistics.csv\"\n",
    "\n",
    "MODELS = [\n",
    "    \"deepseek/deepseek-v4.1-flash_class\",\n",
    "    \"qwen/qwen3-coder-plus_class\",\n",
    "       \"z-ai/glm-5.3-flashx_class\",\n",
    "    \"moonshotai/kimi-k2.7-code_class\",\n",
    "    \"xiaomi/mimo-v2.5-pro_class\",\n",
    "    \"openai/gpt-5.6-terra-pro_class\",\n",
    "    \"openai/gpt-5.3-codex_class\",\n",
    "    \"meta-llama/llama-3.1-70b-instruct_class\",\n",
    "    \"anthropic/claude-haiku-4.5_class\",\n",
    "    \"google/gemma-2-27b-it_class\"\n",
    "]\n",
    "ABS_TOL, REL_TOL = 0.1, 0.05\n",
    "\n",
    "\n",
    "def extract(text):\n",
    "    if pd.isna(text): return None\n",
    "    m = re.search(r\"\\\\begin\\{verbatim\\}(.*?)\\\\end\\{verbatim\\}\", str(text), re.S)\n",
    "    return m.group(1).strip() if m else None\n",
    "\n",
    "\n",
    "def execute(code, timeout=30):\n",
    "    if not code: return None, \"no_code\", \"\", \"\"\n",
    "    path = None\n",
    "    try:\n",
    "        with tempfile.NamedTemporaryFile(\"w\", suffix=\".py\", delete=False,\n",
    "                                         encoding=\"utf-8\") as f:\n",
    "            f.write(code)\n",
    "            path = f.name\n",
    "\n",
    "        p = subprocess.run([sys.executable, path], capture_output=True,\n",
    "                           text=True, timeout=timeout)\n",
    "\n",
    "        if p.returncode:\n",
    "            return None, \"execution_error\", p.stdout, p.stderr\n",
    "\n",
    "        m = re.search(\n",
    "            r\"<result>\\s*([-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?)\\s*</result>\",\n",
    "            p.stdout\n",
    "        )\n",
    "        return (\n",
    "            (float(m.group(1)), \"success\", p.stdout, p.stderr)\n",
    "            if m else (None, \"no_result\", p.stdout, p.stderr)\n",
    "        )\n",
    "\n",
    "    except subprocess.TimeoutExpired:\n",
    "        return None, \"timeout\", \"\", \"Execution timed out\"\n",
    "    except Exception as e:\n",
    "        return None, \"exception\", \"\", str(e)\n",
    "    finally:\n",
    "        if path:\n",
    "            try: os.remove(path)\n",
    "            except OSError: pass\n",
    "\n",
    "\n",
    "def evaluate(pred, expected):\n",
    "    try:\n",
    "        if pd.isna(pred) or pd.isna(expected): raise ValueError\n",
    "        pred, expected = float(pred), float(expected)\n",
    "        ae = abs(pred - expected)\n",
    "        re_ = ae / abs(expected) if expected else ae\n",
    "        return ae, re_, ae <= ABS_TOL or re_ <= REL_TOL\n",
    "    except (ValueError, TypeError):\n",
    "        return None, None, False\n",
    "\n",
    "\n",
    "def find_reference(df):\n",
    "    names = [\n",
    "        \"Numerical Solution\", \"Numerical solution\", \"numerical solution\",\n",
    "        \"Numerical_Solution\", \"numerical_solution\", \"NumericalSolution\",\n",
    "        \"numericalsolution\", \"Reference Solution\", \"Reference solution\",\n",
    "        \"reference solution\", \"Reference\", \"reference\", \"Answer\", \"answer\"\n",
    "    ]\n",
    "\n",
    "    for name in names:\n",
    "        if name in df.columns: return name\n",
    "\n",
    "    norm = {re.sub(r\"[^a-z0-9]\", \"\", c.lower()): c for c in df.columns}\n",
    "\n",
    "    for name in (\"numericalsolution\", \"referencesolution\", \"reference\", \"answer\"):\n",
    "        if name in norm: return norm[name]\n",
    "\n",
    "    raise ValueError(f\"Coluna de referência não encontrada: {list(df.columns)}\")\n",
    "\n",
    "\n",
    "df = pd.read_csv(INPUT_FILE, encoding=\"utf-8\")\n",
    "df.columns = df.columns.astype(str).str.strip()\n",
    "ref = find_reference(df)\n",
    "\n",
    "print(f\"Dataset: {len(df)} problemas | Referência: {ref}\")\n",
    "\n",
    "statistics = []\n",
    "\n",
    "for model in MODELS:\n",
    "    print(f\"\\n{'=' * 60}\\nMODELO: {model}\\n{'=' * 60}\")\n",
    "\n",
    "    if model not in df:\n",
    "        print(f\"Coluna não encontrada: {model}\")\n",
    "        continue\n",
    "\n",
    "    data = {k: [] for k in\n",
    "            [\"result\", \"status\", \"stdout\", \"stderr\",\n",
    "             \"abs_error\", \"rel_error\", \"correct\"]}\n",
    "\n",
    "    for text, expected in tqdm(\n",
    "        zip(df[model], df[ref]), total=len(df), desc=model\n",
    "    ):\n",
    "        result, status, stdout, stderr = execute(extract(text))\n",
    "        ae, re_, correct = evaluate(result, expected)\n",
    "\n",
    "        for k, v in zip(\n",
    "            data, [result, status, stdout, stderr, ae, re_, correct]\n",
    "        ):\n",
    "            data[k].append(v)\n",
    "\n",
    "    for k, values in data.items():\n",
    "        df[f\"{model}_{k}\"] = values\n",
    "\n",
    "    total = len(data[\"status\"])\n",
    "    success = data[\"status\"].count(\"success\")\n",
    "    correct = sum(x is True for x in data[\"correct\"])\n",
    "    errors = {s: data[\"status\"].count(s) for s in\n",
    "              [\"execution_error\", \"no_result\", \"no_code\", \"timeout\", \"exception\"]}\n",
    "\n",
    "    execution_rate = 100 * success / total if total else 0\n",
    "    correct_rate = 100 * correct / total if total else 0\n",
    "    executable_rate = 100 * correct / success if success else 0\n",
    "\n",
    "    statistics.append({\n",
    "        \"Model\": model,\n",
    "        \"Total\": total,\n",
    "        \"Executed OK\": success,\n",
    "        \"Numerically Correct\": correct,\n",
    "        \"Execution Errors\": errors[\"execution_error\"],\n",
    "        \"No <result>\": errors[\"no_result\"],\n",
    "        \"No Code\": errors[\"no_code\"],\n",
    "        \"Timeout\": errors[\"timeout\"],\n",
    "        \"Exceptions\": errors[\"exception\"],\n",
    "        \"Execution Rate (%)\": round(execution_rate, 2),\n",
    "        \"Correct Rate (%)\": round(correct_rate, 2),\n",
    "        \"Correct Among Executable (%)\": round(executable_rate, 2)\n",
    "    })\n",
    "\n",
    "    print(f\"\"\"\n",
    "Total:                       {total}\n",
    "Executados OK:               {success}\n",
    "Numericamente corretos:      {correct}\n",
    "Erros de execução:           {errors[\"execution_error\"]}\n",
    "Sem <result>:                {errors[\"no_result\"]}\n",
    "Sem código:                  {errors[\"no_code\"]}\n",
    "Timeout:                     {errors[\"timeout\"]}\n",
    "Exceções:                    {errors[\"exception\"]}\n",
    "Taxa de execução:            {execution_rate:.2f}%\n",
    "Taxa correta:                {correct_rate:.2f}%\n",
    "Precisão entre executáveis:  {executable_rate:.2f}%\n",
    "\"\"\")\n",
    "\n",
    "    df.to_csv(OUTPUT_FILE, index=False, encoding=\"utf-8\")\n",
    "\n",
    "summary = pd.DataFrame(statistics)\n",
    "summary.to_csv(SUMMARY_FILE, index=False, encoding=\"utf-8\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 70)\n",
    "print(\"PROCESSAMENTO CONCLUÍDO\")\n",
    "print(\"=\" * 70)\n",
    "print(f\"Resultados:   {OUTPUT_FILE}\")\n",
    "print(f\"Estatísticas: {SUMMARY_FILE}\")\n",
    "print(\"\\n\" + summary.to_string(index=False))"
   ]
