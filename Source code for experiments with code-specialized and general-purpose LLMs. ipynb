    "import hashlib\n",
    "import json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "DATASET_FILE = Path(\"ODE_math_benchmark_2026.csv\")\n",
    "CACHE_FILE = Path(\"ode_python_code_cache.json\")\n",
    "OUTPUT_FILE = Path(\"ODE_math_benchmark_2026.csv_models\")\n",
    "\n",
    "if not DATASET_FILE.exists():\n",
    "    raise FileNotFoundError(f\"Dataset não encontrado:\\n{DATASET_FILE.resolve()}\")\n",
    "\n",
    "# Load cache\n",
    "cache = {}\n",
    "if CACHE_FILE.exists():\n",
    "    try:\n",
    "        with CACHE_FILE.open(encoding=\"utf-8\") as f:\n",
    "            cache = json.load(f)\n",
    "        print(f\"Cache carregado: {len(cache)} entradas\")\n",
    "    except Exception as e:\n",
    "        print(f\"Erro ao carregar cache: {e}. Novo cache será criado.\")\n",
    "else:\n",
    "    print(\"Nenhum cache encontrado. Novo cache será criado.\")\n",
    "\n",
    "def cache_key(model, question, solution):\n",
    "    return hashlib.md5(\n",
    "        f\"{model}\\n{question}\\n{solution}\".encode(\"utf-8\")\n",
    "    ).hexdigest()\n",
    "\n",
    "def save_cache():\n",
    "    with CACHE_FILE.open(\"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(cache, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "# Load dataset\n",
    "df = pd.read_csv(DATASET_FILE, encoding=\"utf-8\")\n",
    "required = {\"Question\", \"Proposed Solution\"}\n",
    "\n",
    "if not required.issubset(df.columns):\n",
    "    raise ValueError(f\"Colunas obrigatórias ausentes: {required - set(df.columns)}\")\n",
    "\n",
    "print(f\"Dataset: {len(df)} problemas\")\n",
    "print(f\"Colunas: {list(df.columns)}\")\n",
    "\n",
    "models = [\n",
    "    \"deepseek/deepseek-v4.1-flash\",\n",
    "    \"qwen/qwen3-coder-plus\",\n",
    "       \"z-ai/glm-5.3-flashx\",\n",
    "    \"moonshotai/kimi-k2.7-code\",\n",
    "    \"xiaomi/mimo-v2.5-pro\",\n",
    "    \"openai/gpt-5.6-terra-pro\",\n",
    "    \"openai/gpt-5.3-codex\",\n",
    "    \"meta-llama/llama-3.1-70b-instruct\",\n",
    "    \"anthropic/claude-haiku-4.5\",\n",
    "    \"google/gemma-2-27b-it\"\n",
    "]\n",
    "\n",
    "for model in models:\n",
    "    print(f\"\\n{'=' * 60}\\nProcessando: {model}\\n{'=' * 60}\")\n",
    "\n",
    "    model_col = f\"{model}_class\"\n",
    "    existing = (\n",
    "        df[model_col].where(df[model_col].notna(), None).tolist()\n",
    "        if model_col in df.columns\n",
    "        else [None] * len(df)\n",
    "    )\n",
    "\n",
    "    responses = []\n",
    "\n",
    "    for i, row in df.iterrows():\n",
    "        question, solution = str(row[\"Question\"]), str(row[\"Proposed Solution\"])\n",
    "        key = cache_key(model, question, solution)\n",
    "\n",
    "        if key in cache:\n",
    "            responses.append(cache[key])\n",
    "            print(f\"✓ Cache: {i}\")\n",
    "            continue\n",
    "\n",
    "        value = existing[i]\n",
    "\n",
    "        if (\n",
    "            value is not None\n",
    "            and str(value).strip()\n",
    "            and str(value).strip().lower() not in {\"none\", \"nan\", \"error\"}\n",
    "        ):\n",
    "            result = value\n",
    "            print(f\"↻ Existente: {i}\")\n",
    "\n",
    "        else:\n",
    "            result = \"error\"\n",
    "\n",
    "            for attempt in range(1, 4):\n",
    "                try:\n",
    "                    print(f\"→ Índice {i} | Tentativa {attempt}/3\")\n",
    "                    rsp = ODE_python_code_generation(model, question, solution)\n",
    "\n",
    "                    if (\n",
    "                        rsp is not None\n",
    "                        and str(rsp).strip()\n",
    "                        and str(rsp).strip().lower() != \"error\"\n",
    "                    ):\n",
    "                        result = rsp\n",
    "                        print(f\"✓ Resposta: {i}\")\n",
    "                        break\n",
    "\n",
    "                except Exception as e:\n",
    "                    print(f\"Erro: {e}\")\n",
    "\n",
    "            cache[key] = result\n",
    "\n",
    "        responses.append(result)\n",
    "\n",
    "        if (i + 1) % 10 == 0 or i == len(df) - 1:\n",
    "            save_cache()\n",
    "            print(f\"💾 Cache salvo após índice {i}\")\n",
    "\n",
    "    df[model_col] = responses\n",
    "    save_cache()\n",
    "    df.to_csv(OUTPUT_FILE, index=False, encoding=\"utf-8\")\n",
    "\n",
    "    print(f\"✓ {model} concluído.\")\n",
    "\n",
    "# Final save\n",
    "df.to_csv(OUTPUT_FILE, index=False, encoding=\"utf-8\")\n",
    "\n",
    "print(\n",
    "    f\"\\n{'=' * 60}\\n\"\n",
    "    f\"✅ PROCESSAMENTO COMPLETO\\n\"\n",
    "    f\"Problemas: {len(df)}\\n\"\n",
    "    f\"Modelos: {len(models)}\\n\"\n",
    "    f\"Cache: {CACHE_FILE.resolve()}\\n\"\n",
    "    f\"Resultados: {OUTPUT_FILE.resolve()}\"\n",
    ")\n",
    "\n"
   ]
